{
  "name": "xrpl-stablecoin-portal",
  "version": "0.1.0",
  "private": true,
  "description": "XRPL JPY Portal (React + Vite monorepo)",
  "keywords": [
    "xrpl",
    "stablecoin",
    "portal",
    "react",
    "vite",
    "firebase",
    "tailwindcss",
    "typescript"
  ],
  "license": "MIT",
  "author": "chicunic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicunic/xrpl-stablecoin-portal.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:token": "pnpm -F @xrpl-stablecoin-portal/token dev",
    "dev:bank": "pnpm -F @xrpl-stablecoin-portal/bank dev",
    "build": "pnpm -r build",
    "build:token": "pnpm -F @xrpl-stablecoin-portal/token build",
    "build:bank": "pnpm -F @xrpl-stablecoin-portal/bank build",
    "preview:token": "pnpm -F @xrpl-stablecoin-portal/token preview",
    "preview:bank": "pnpm -F @xrpl-stablecoin-portal/bank preview",
    "check": "pnpm -r --parallel exec tsc6 --noEmit && eslint && prettier --check .",
    "fix": "eslint --fix && prettier --write .",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "ripple-address-codec": "^5.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
