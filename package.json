{
  "name": "xrpl-stablecoin-portal",
  "version": "0.1.0",
  "description": "XRPL JPY Portal (React + Vite monorepo)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:token": "pnpm -F @xrpl-stablecoin-portal/token dev",
    "dev:bank": "pnpm -F @xrpl-stablecoin-portal/bank dev",
    "build": "pnpm -r build",
    "build:token": "pnpm -F @xrpl-stablecoin-portal/token build",
    "build:bank": "pnpm -F @xrpl-stablecoin-portal/bank build",
    "preview:token": "pnpm -F @xrpl-stablecoin-portal/token preview",
    "preview:bank": "pnpm -F @xrpl-stablecoin-portal/bank preview",
    "check": "pnpm -r --parallel exec tsc --noEmit && eslint && prettier --check .",
    "fix": "eslint --fix && prettier --write .",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.18.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "ripple-address-codec": "^5.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
