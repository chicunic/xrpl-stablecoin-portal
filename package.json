{
  "name": "xrpl-stablecoin-portal",
  "version": "0.1.0",
  "description": "XRPL JPY Portal (React + Vite monorepo)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:token": "pnpm -F @xrpl-stablecoin-portal/token dev",
    "dev:bank": "pnpm -F @xrpl-stablecoin-portal/bank dev",
    "build": "pnpm -r build",
    "build:token": "pnpm -F @xrpl-stablecoin-portal/token build",
    "build:bank": "pnpm -F @xrpl-stablecoin-portal/bank build",
    "preview:token": "pnpm -F @xrpl-stablecoin-portal/token preview",
    "preview:bank": "pnpm -F @xrpl-stablecoin-portal/bank preview",
    "check": "pnpm -r --parallel exec tsc --noEmit && biome check",
    "fix": "biome check --write --unsafe",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "lucide-react": "^1.7.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "shadcn": "^4.1.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.3"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
